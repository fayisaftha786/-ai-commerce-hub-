# Private Node.js backend only. Never put these values in GitHub Pages or frontend JavaScript.
NODE_ENV=production
PORT=3000

# Google Cloud OAuth 2.0 Web application. Set the callback URI exactly as registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-private-backend.example/api/social/youtube/callback

# Generate once with: openssl rand -base64 32
# Back up this key securely. Losing it makes the encrypted token vault unreadable.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Persistent private disk path for AES-256-GCM encrypted provider tokens.
SOCIAL_TOKEN_STORE_PATH=/var/data/social-token-vault.json

# Exact frontend origin only; no wildcard and no path.
SOCIAL_CORS_ORIGINS=https://fayisaftha786.github.io

# The fixed page users return to after Google's consent screen.
SOCIAL_RETURN_URL=https://fayisaftha786.github.io/-ai-commerce-hub-/

# Existing public discovery worker settings (optional).
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=360
DISCOVERY_STORE_PATH=/var/data/content-rewards-discovery.json
DISCOVERY_CORS_ORIGINS=https://fayisaftha786.github.io
