# Private Node.js backend only. Never put these values in GitHub Pages or frontend JavaScript.
NODE_ENV=production
PORT=3000
SERVE_STATIC_APP=true
STATIC_SITE_DIR=/tmp/ai-commerce-hub-site

# Google Cloud OAuth 2.0 Web application. Register this exact callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app-host.example/api/social/youtube/callback

# Generate once with: openssl rand -base64 32
# Back up this key securely. Losing it makes the encrypted token vault unreadable.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Attach a persistent private volume at /data before relying on account connections.
SOCIAL_TOKEN_STORE_PATH=/data/social-token-vault.json
DISCOVERY_STORE_PATH=/data/content-rewards-discovery.json

# Same-origin app/API deployment. Use the exact deployed HTTPS origin, no path or wildcard.
SOCIAL_CORS_ORIGINS=https://your-app-host.example
SOCIAL_RETURN_URL=https://your-app-host.example/
SOCIAL_COOKIE_SAMESITE=Lax

# GitHub Actions is the canonical scheduled campaign snapshot pipeline.
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=360
DISCOVERY_CORS_ORIGINS=https://your-app-host.example
