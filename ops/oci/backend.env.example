# Copy this file to .env on the VM. Never commit the filled .env file.
SITE_HOST=your-subdomain.duckdns.org
ACME_EMAIL=you@example.com

NODE_ENV=production
PORT=3000
SERVE_STATIC_APP=true
STATIC_SITE_DIR=/tmp/ai-commerce-hub-site

# Google OAuth 2.0 Web application. Register the exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-subdomain.duckdns.org/api/social/youtube/callback

# Meta app for Facebook Page Reels and linked Instagram Professional Reels.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-subdomain.duckdns.org/api/social/meta/callback
META_GRAPH_API_VERSION=v26.0
META_MEDIA_BASE_URL=https://your-subdomain.duckdns.org

# Generate on the VM with: openssl rand -base64 32
# Keep this key private and back it up separately from /data.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Named Docker volume is mounted at /data by compose.oci.yml.
SOCIAL_TOKEN_STORE_PATH=/data/social-token-vault.json
DISCOVERY_STORE_PATH=/data/content-rewards-discovery.json

# GitHub Actions remains the canonical six-hour public campaign snapshot pipeline.
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=360
DISCOVERY_CORS_ORIGINS=https://your-subdomain.duckdns.org

# Same-origin deployment: keep the exact HTTPS origin, with no trailing slash.
SOCIAL_CORS_ORIGINS=https://your-subdomain.duckdns.org
SOCIAL_RETURN_URL=https://your-subdomain.duckdns.org/
SOCIAL_COOKIE_SAMESITE=Lax
